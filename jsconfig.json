{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "experimentalDecorators": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "baseUrl": ".",
    "allowJs": true,
    "paths": {
      "@playwright/test": [
        "./tests/support/playwright-test-bridge.js"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "playwright.config.js",
    "playwright.config.mjs",
    "playwright.config.cjs"
  ],
  "include": [
    "tests/**/*.js"
  ]
}
